generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LibraryStatus {
  READING
  PLAN_TO_READ
  COMPLETED
  PAUSED
  DROPPED
}

enum RagSourceType {
  MANGA
  CHAPTER
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum UserRole {
  USER
  ADMIN
}

enum CommentTargetType {
  MANGA
  CHAPTER
}

enum CommentStatus {
  VISIBLE
  DELETED
  HIDDEN
}

enum CommentReactionType {
  LIKE
  HEART
  SAD
  LAUGH
  ANGRY
}

enum NotificationType {
  COMMENT_REPLY
  COMMENT_REACTION
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  CHAT_MESSAGE
  GROUP_INVITE
  MISSED_CALL
}

enum NotificationSubjectType {
  COMMENT
  FRIENDSHIP
  CONVERSATION
  MESSAGE
  CALL
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum SocialConversationType {
  DM
  GROUP
}

enum SocialMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SocialMembershipStatus {
  ACTIVE
  PENDING_INVITE
  LEFT
}

enum SocialMessageType {
  TEXT
  MANGA_SHARE
  IMAGE
  SYSTEM
  VOICE_NOTE
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

enum CallMediaType {
  AUDIO
  VIDEO
}

enum CallParticipantStatus {
  INVITED
  JOINED
  DECLINED
  LEFT
  MISSED
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  displayName     String
  role            UserRole          @default(USER)
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]
  libraryItems    LibraryItem[]
  progress        ReadingProgress[]
  bookmarks       Bookmark[]
  searchHistory   SearchHistory[]
  chatConversations ChatConversation[]
  comments        Comment[]
  commentReactions CommentReaction[]
  notifications   Notification[]     @relation("NotificationRecipient")
  notificationActors Notification[]   @relation("NotificationActor")
  friendshipsAs      Friendship[]     @relation("FriendshipUserA")
  friendshipsBs      Friendship[]     @relation("FriendshipUserB")
  friendshipRequests Friendship[]     @relation("FriendshipRequester")
  friendshipBlocks   Friendship[]     @relation("FriendshipBlocker")
  socialMemberships  SocialConversationMember[]
  socialMessages     SocialMessage[]
  messageReactions   MessageReaction[]
  initiatedCalls      CallSession[]     @relation("CallInitiator")
  callParticipants    CallParticipant[]

  @@index([role])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LibraryItem {
  id            String        @id @default(cuid())
  userId        String
  mangaId       String
  status        LibraryStatus @default(READING)
  isFavorite    Boolean       @default(false)
  lastChapterId String?
  lastReadAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@index([userId, updatedAt])
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  mangaId    String
  chapterId  String
  pageIndex  Int      @default(0)
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, mangaId, updatedAt])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  mangaId    String
  chapterId  String
  pageIndex  Int      @default(0)
  note       String?
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, mangaId])
  @@index([userId, updatedAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CachedManga {
  id            String          @id
  title         String
  altTitles     Json
  description   String
  status        String?
  year          Int?
  contentRating String?
  tags          String[]
  authors       String[]        @default([])
  artists       String[]        @default([])
  coverUrl      String?
  source        String          @default("mangadex")
  fetchedAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  chapters      CachedChapter[]

  @@index([title])
  @@index([fetchedAt])
}

model MangaDexTag {
  id        String   @id
  name      String
  group     String
  aliases   String[] @default([])
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([group])
  @@index([fetchedAt])
}

model CachedChapter {
  id                 String      @id
  mangaId            String
  title              String
  chapter            String?
  volume             String?
  translatedLanguage String
  publishAt          DateTime?
  pages              Int         @default(0)
  scanlationGroup    String?
  fetchedAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  manga              CachedManga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@index([mangaId, translatedLanguage])
  @@index([mangaId, chapter])
  @@index([publishAt])
}

model RagDocument {
  id             String                   @id @default(cuid())
  sourceType     RagSourceType
  sourceId       String
  parentSourceId String?
  title          String
  content        String
  metadata       Json
  contentHash    String
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  indexedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
  @@index([sourceId])
  @@index([parentSourceId])
  @@index([contentHash])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String
  sources        Json?
  suggestedActions Json?
  model          String?
  tokenUsage     Json?
  latencyMs      Int?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Friendship {
  id            String           @id @default(cuid())
  userAId       String
  userBId       String
  requestedById String
  blockedById   String?
  status        FriendshipStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userA         User             @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User             @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)
  requestedBy   User             @relation("FriendshipRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  blockedBy     User?            @relation("FriendshipBlocker", fields: [blockedById], references: [id], onDelete: SetNull)

  @@unique([userAId, userBId])
  @@index([userAId, status, updatedAt])
  @@index([userBId, status, updatedAt])
  @@index([requestedById, status])
}

model SocialConversation {
  id            String                     @id @default(cuid())
  type          SocialConversationType
  title         String?
  avatarUrl     String?
  directKey     String?
  lastMessageAt DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  members       SocialConversationMember[]
  messages      SocialMessage[]
  calls         CallSession[]

  @@index([type, lastMessageAt])
  @@index([directKey])
}

model SocialConversationMember {
  id                String                 @id @default(cuid())
  conversationId    String
  userId            String
  role              SocialMemberRole       @default(MEMBER)
  status            SocialMembershipStatus @default(ACTIVE)
  lastReadMessageId String?
  lastReadAt        DateTime?
  mutedUntil        DateTime?
  joinedAt          DateTime               @default(now())
  conversation      SocialConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, status, joinedAt])
  @@index([conversationId, role, status])
}

model SocialMessage {
  id              String             @id @default(cuid())
  conversationId  String
  senderId        String?
  clientMessageId String?
  type            SocialMessageType  @default(TEXT)
  content         String?
  attachments     Json?
  replyToId       String?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  conversation    SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo         SocialMessage?     @relation("SocialMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         SocialMessage[]    @relation("SocialMessageReplies")
  reactions       MessageReaction[]

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([replyToId])
}

model MessageReaction {
  id        String        @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  message   SocialMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model CallSession {
  id             String            @id @default(cuid())
  conversationId String
  initiatorId    String
  status         CallStatus        @default(RINGING)
  mediaType      CallMediaType
  startedAt      DateTime          @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  conversation   SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator      User              @relation("CallInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  participants   CallParticipant[]

  @@index([conversationId, status, startedAt])
  @@index([initiatorId, startedAt])
}

model CallParticipant {
  id        String                @id @default(cuid())
  callId    String
  userId    String
  status    CallParticipantStatus @default(INVITED)
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  call      CallSession           @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId, status, updatedAt])
  @@index([callId, status])
}

model Comment {
  id            String                @id @default(cuid())
  targetType    CommentTargetType
  targetId      String
  authorId      String
  parentId      String?
  rootId        String?
  depth         Int                   @default(0)
  path          String
  content       String
  isSpoiler     Boolean               @default(false)
  status        CommentStatus         @default(VISIBLE)
  deletedAt     DateTime?
  hiddenAt      DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  author        User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?              @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]             @relation("CommentReplies")
  root          Comment?              @relation("CommentRoot", fields: [rootId], references: [id], onDelete: Cascade)
  descendants   Comment[]             @relation("CommentRoot")
  reactions     CommentReaction[]

  @@index([targetType, targetId, parentId, createdAt])
  @@index([targetType, targetId, rootId, path])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@index([rootId])
}

model CommentReaction {
  id        String              @id @default(cuid())
  commentId String
  userId    String
  type      CommentReactionType
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  comment   Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, updatedAt])
  @@index([commentId, type])
}

model Notification {
  id          String                  @id @default(cuid())
  userId      String
  actorId     String
  type        NotificationType
  subjectType NotificationSubjectType
  subjectId   String
  payload     Json?
  readAt      DateTime?
  createdAt   DateTime                @default(now())
  user        User                    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor       User                    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([actorId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}
