# PostgreSQL synthetic source database
SOURCE_DB_HOST=postgres-source
SOURCE_DB_PORT=5432
SOURCE_DB_HOST_PORT=15432
SOURCE_DB_NAME=manga_source
SOURCE_DB_USER=manga_de
SOURCE_DB_PASSWORD=manga_de
SOURCE_DATABASE_URL=postgresql://manga_de:manga_de@postgres-source:5432/manga_source

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC_USER_EVENTS=manga.user_events

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_APP_NAME=manga-reading-analytics
SPARK_MASTER_UI_PORT=18080
SPARK_MASTER_CLUSTER_PORT=17077
SPARK_WORKER_UI_PORT=18081

# MinIO data lake / warehouse
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=manga-analytics
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Data lake paths
BRONZE_EVENTS_PATH=s3a://manga-analytics/bronze/events
SILVER_EVENTS_PATH=s3a://manga-analytics/silver/events
GOLD_BASE_PATH=s3a://manga-analytics/gold
CHECKPOINT_BASE_PATH=s3a://manga-analytics/checkpoints

# Producer defaults
SYNTHETIC_USER_COUNT=3000
PRODUCER_EVENT_COUNT=100000
PRODUCER_EVENTS_PER_SECOND=200

# Real manga catalog source
MANGADEX_BASE_URL=https://api.mangadex.org
MANGADEX_PAGE_LIMIT=100
MANGADEX_MANGA_TARGET_COUNT=600
MANGADEX_CHAPTERS_PER_MANGA=20
MANGADEX_REQUEST_DELAY_SECONDS=0.5
